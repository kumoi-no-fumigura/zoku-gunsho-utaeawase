 "blocks": [
  {
   "id": "zoku-gunsho-utaeawase-0001",
   "pid": "nao-734208",
   "pages": [
    1
   ],
   "text": "まつこふるこゑなかりけはさをしかのたへまを人はいかてしらまし十番楼衣左式部よとゝもにころもうつなるおとにまて人まつやとはしるへきこゆれ右秋風のふきしまされはかりころもうつ春あまたきこゆなるかな歌絵合やみひの十日あまりのゆふくれに月影みつにうつるおりしも人あまたさふらひて物かたりのついてにたれともなくいひあはせしはるの日のつれ〳〵にくらすよりはつねならぬいとみことをおまへに御覧せさせはやむかしよりきこゆる花あはせなとはちりてふるきねにかへりぬれはにほひこひしくくさあはせとかはたつねてもとのところにかへしやれはなこりうるさしさておくらか歌林とかいふなるより古万",
   "poems": [
    "1",
    "2",
    "3",
    "4",
    "5"
   ]
  },
  {
   "id": "zoku-gunsho-utaeawase-0002",
   "pid": "nao-734208",
   "pages": [
    2
   ],
   "text": "葉集まてはこゝろもおよはす古今後撰こそあをやまのいとくりかへしみれともあかすもみちのにしきうめいたすこゝろふかきいろなれとて左各にさためつ哥繪にかくはよのつねのことなれはるよみ人をかくへきなりことはをとれは歌はかきにくしうたをえるにはことはあらはれすかみのこゝろにはめてらるゝとも人のそしりをはのかれかたしいにしへうたのふるきにそへてもあたらしきことのあさくともあらんはめつらしくやとてうたみつをそへたりつるうの花月ほとゝきすこそあるつきほとなれとおほとのゝ寄合の影なれはつるにかへたるなり女房廿人を十人つゝとりわけて絵かく人をつて〳〵にたつぬるほとに水月のなかはにもなりぬれはあふひのさかりにひきかゝりてもろ人いて方なきころをすくして廿六日に空のけしきくもりなきに寝殿のひんかし物もてのもやひさしをかんたちめのおほんさにしたり源大納言殿小野宮の中納言左衛門督新中納言左衛門督新中納言左衛門督新中納言中宮権大夫咎大弁左大弁左大弁三位侍従殿上人は",
   "poems": [
    "6",
    "7",
    "8"
   ]
  },
  {
   "id": "zoku-gunsho-utaeawase-0003",
   "pid": "nao-734208",
   "pages": [
    3
   ],
   "text": "くらへ馬のさためしける日なれはそのとまつより右のとうの中将つき〳〵八九人はかりひきつれてまいりとまへりみすのうちには北南雨わきて左なてしこかさね右ふちかさね左かねのすきはこにこゝちはしてかねのうのはなかさねのかみしきてかねのむすひふくろにいろ〳〵のたまをむらこにつらぬきてくゝりにしたり古今絵七帖あたらしきかた絵のかねのさうし一一帖いれたりへうしさま〳〵にかさりたりうちしきなてしこのふせむれうにうのはをぬいたりかすさしかねのすはまにさしてのいそをつくりていわやまに松おほくうへたるをかすに八はまへにさしうつすへきなりうちしきふかみとりのふせむれうなり右かゝみのうみにかねのあみをうかへてたまのいかりにかねのつなをかけたりかねのすきはこをうちにをきて絵のさうし六帖あたらしき絵のさうし一帖いれたりへうしさま〳〵にかさりたりうちしきふたあゐのさうかにしろき文をぬいたりかすさしかねの寸はまにかねのつるあまたたてたり",
   "poems": [
    "9",
    "10",
    "11",
    "12"
   ]
  },
  {
   "id": "zoku-gunsho-utaeawase-0004",
   "pid": "nao-734208",
   "pages": [
    4
   ],
   "text": "ちとせつもれるといふこゝろなりかすにはつるのうらつたひすへきなりうちしきふかみとりのさうかにぬひものしたり日もやう〳〵くれぬれはこなたかなたにゐわきたまふおほきとのはくゝませたまふおほむすかたなれと上らふものしたまふとてしのひあへさせたまはす左うたよむ人四位少将右兵衛佐かた〳〵のさうしとりてよみあわするほとにひたりのかたより頭弁人々七は人くしてまいりたまへりかた〳〵うるはしくなりて一二番かんたちめのおほん中にさためもやりたまはぬに殿上人いとみことさためそむる日なるをかちまけはいみあることになんとはへりしかとけにこのゑともゝおほろけにては見さためかたきことのさまなれはとてたゝこれたに見たまふなか〳〵かちまけあらんよりはみたれをかしくそ見はてたまふて鶴左をのゝみやの中納言あたらしきうたよみたまふみろつよのかけをならへて鶴のすむふちえのうらは松そ木高き",
   "poems": [
    "13",
    "14",
    "15",
    "16",
    "17",
    "18",
    "19",
    "20"
   ]
  },
  {
   "id": "zoku-gunsho-utaeawase-0005",
   "pid": "nao-734208",
   "pages": [
    5
   ],
   "text": "こゝろはへありすかたかさりをかしきはし事右新中納言よみたまふはかへせぬ松のねくらにむれちとせを君にみな遊つるかなつゝきなともをかしときこゆるに左の人々はかへとあるをなんいひなしたまふやうありける卯花左みわたせはなみのしからみかけてけりうの花さける玉川の里したゝかにきこゆれと右はうの花のさけるさかりは白波のたつたの川のゐせきとそみるすゑいまめかしくこゝろありなとはへるはゆかぬことにそ月左やとことにかはらぬものは山のはの月をなかむる心なりけりゑのさまをかしくおもひあるやうなりなとほめ給ふに右山のはのからめしかは池水にいれとも月はかくれさりけり",
   "poems": [
    "21",
    "22",
    "23",
    "24",
    "25"
   ]
  },
  {
   "id": "zoku-gunsho-utaeawase-0006",
   "pid": "nao-734208",
   "pages": [
    6
   ],
   "text": "なへてならすやつゝみもなうほめたまふとその弁みまさかのかみなとあまりなるまてきこゆかくてわたとのにうつりたまふましにはやくよりふりにけるやり水なれとこよひあたらしくていしなとをほめたまふかはらけあまたたひになりておほんことなとははゝからせたまへは大納言殿ふちせとなる丁ゑとはへりしにありしほとにひきてものゝうまにやともしひのかけにみゆるはひさかたのつきけならねと目とまりはへりしかゝることはかたはらいたけ利とゆく末もときはの松のことのはをかきとゝめすはちよへんつるのふるきあとたつねましきこともやあるとてなむ西行法師の手跡にて写侍る也",
   "poems": [
    "26",
    "27"
   ]
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "まつこふるこゑなかりけはさをしかのたへまを人はいかてしらまし",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": ""
  },
  {
   "seq": "2",
   "text": "よとゝもにころもうつなるおとにまて人まつやとはしるへきこゆれ",
   "kana": "",
   "speaker": "式部",
   "page": 1,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "3",
   "text": "秋風のふきしまされはかりころもうつ春あまたきこゆなるかな",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "4",
   "text": "日のつれ〳〵にくらすよりはつねならぬいとみ",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "5",
   "text": "ことをおまへに御覧せさせはやむかしよりきこ",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "6",
   "text": "ふるきにそへてもあたらしきことのあさくとも",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "7",
   "text": "りつるうの花月ほとゝきすこそあるつきほとな",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "8",
   "text": "人をつて〳〵にたつぬるほとに水月のなかはに",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "9",
   "text": "より右のとうの中将つき〳〵八九人はかりひき",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "10",
   "text": "さねのかみしきてかねのむすひふくろにいろ〳〵",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "11",
   "text": "一一帖いれたりへうしさま〳〵にかさりたりうち",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "12",
   "text": "れたりへうしさま〳〵にかさりたりうちしきふ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "13",
   "text": "りのさうかにぬひものしたり日もやう〳〵くれ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "14",
   "text": "左うたよむ人四位少将右兵衛佐かた〳〵のさう",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "15",
   "text": "り頭弁人々七は人くしてまいりたまへりかた〳〵",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "16",
   "text": "中にさためもやりたまはぬに殿上人いとみこと",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "17",
   "text": "さためそむる日なるをかちまけはいみあること",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "18",
   "text": "ろけにては見さためかたきことのさまなれはと",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "19",
   "text": "てたゝこれたに見たまふなか〳〵かちまけあら",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "20",
   "text": "みろつよのかけをならへて鶴のすむふちえのうらは松そ木高き",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "21",
   "text": "はかへせぬ松のねくらにむれちとせを君にみな遊つるかな",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "22",
   "text": "みわたせはなみのしからみかけてけりうの花さける玉川の里",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "23",
   "text": "うの花のさけるさかりは白波のたつたの川のゐせきとそみる",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "右",
   "dai": "は"
  },
  {
   "seq": "24",
   "text": "やとことにかはらぬものは山のはの月をなかむる心なりけり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "左",
   "dai": "は"
  },
  {
   "seq": "25",
   "text": "山のはのからめしかは池水にいれとも月はかくれさりけり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "右",
   "dai": "は"
  },
  {
   "seq": "26",
   "text": "目とまりはへりしかゝることはかたはらいたけ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": "は"
  },
  {
   "seq": "27",
   "text": "利とゆく末もときはの松のことのはをかきとゝ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734208",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": "は"
  }
 ],
